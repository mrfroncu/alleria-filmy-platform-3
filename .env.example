# === Discord OAuth2 ===
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# IMPORTANT: Must match EXACTLY what is in Discord Developer Portal > OAuth2 > Redirects
# Both /auth/discord/callback and /api/auth/discord/callback work
DISCORD_REDIRECT_URI=https://your-domain.com/auth/discord/callback
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_guild_id

# === Discord Role IDs ===
# Role that grants basic access to the platform
DISCORD_MEMBER_ROLE_ID=123456789012345678
# Role that grants admin/editor access
DISCORD_ADMIN_ROLE_ID=123456789012345679
# Role that grants developer/debug access — always read from here, never overridable in-app
DISCORD_DEV_ROLE_ID=123456789012345680
# Whether DISCORD_MEMBER_ROLE_ID / DISCORD_ADMIN_ROLE_ID above are overridable from
# Dev Tools > Ustawienia > Logowanie ("panel") or always read from here ("env", default).
# This flag itself is only read at boot — flip it here and restart the container to change it.
# Everything else Discord-related (client id/secret, bot token, guild id, redirect uri, dev role)
# is ALWAYS env-only, with no in-app override, regardless of this flag.
# DISCORD_ROLES_CONFIG_SOURCE=panel

# === Authentik SSO (OpenID Connect) — optional ===
# The "Zaloguj przez ..." SSO button appears on the login page only when URL, client id, secret
# and redirect URI are all set. In Authentik: Applications > Providers > create an
# "OAuth2/OpenID Provider" (Client type: Confidential), then an Application bound to it.
# Base URL of your Authentik instance — no trailing path (the app uses the standard
# /application/o/authorize|token|userinfo/ endpoints under it).
# AUTHENTIK_URL=https://auth.alleria.pl
# AUTHENTIK_CLIENT_ID=your_authentik_client_id
# AUTHENTIK_CLIENT_SECRET=your_authentik_client_secret
# Must be added to the provider's "Redirect URIs" in Authentik (strict match).
# Both /auth/authentik/callback and /api/auth/authentik/callback work.
# AUTHENTIK_REDIRECT_URI=https://your-domain.com/auth/authentik/callback
# Name shown on the login button / profile page (default: "Authentik").
# AUTHENTIK_DISPLAY_NAME=Alleria SSO
# Role mapping by Authentik group NAMES (comma-separated, from the `groups` claim of the default
# "profile" scope). Leave AUTHENTIK_MEMBER_GROUPS empty to let in everyone Authentik lets through
# — then restrict access with policy bindings on the Application in Authentik instead.
# AUTHENTIK_MEMBER_GROUPS=alleria-filmy
# AUTHENTIK_ADMIN_GROUPS=alleria-filmy-redaktorzy
# AUTHENTIK_DEV_GROUPS=alleria-filmy-dev
#
# Same person, same account: if your Authentik users log in to Authentik through a Discord
# source, add a Scope Mapping (Customization > Property Mappings > Scope Mapping) with scope name
# "profile" and select it on the provider next to the default ones — its claims get merged in:
#
#   from authentik.sources.oauth.models import UserOAuthSourceConnection
#   conn = UserOAuthSourceConnection.objects.filter(user=request.user, source__slug="discord").first()
#   return {"discord_id": conn.identifier if conn else None}
#
# (replace "discord" with your Discord source's slug). With that, an SSO login lands on the account
# that already has that Discord id, and uses its live Discord guild roles (via DISCORD_BOT_TOKEN)
# exactly like a Discord login would — the role is the better of those and the groups above.
#
# Authentik's default "email" mapping always sends email_verified=false (Authentik doesn't verify
# addresses itself). Set this only if users can't put arbitrary addresses on their Authentik
# accounts (e.g. they all come from Discord, or only admins create them):
# AUTHENTIK_TRUST_EMAIL=true

# === Account matching by e-mail (all OAuth methods) — optional, off by default ===
# On a first login through one method (Discord / Authentik), find the existing account of the same
# person by e-mail instead of creating a second one. Only provider-verified addresses count:
# Discord's own "verified" flag, and Authentik's e-mail when email_verified=true or
# AUTHENTIK_TRUST_EMAIL=true. The e-mail typed into the profile is never used (anyone can type any
# address there). Ambiguous matches (2+ accounts) are skipped. TeamSpeak has no e-mail.
# Matched by Discord id or e-mail, the existing account stays the main one (role, name, history);
# an SSO-only account that was created earlier for the same person is merged into it automatically.
# ACCOUNT_LINK_BY_EMAIL=true

# === TeamSpeak 6 (ServerQuery HTTP API) ===
# Both TS6_ and TS_ prefixes work (e.g. TS6_HOST or TS_SERVER_HOST)
TS_SERVER_HOST=your_teamspeak_server_ip
TS_API_PORT=10080
# TS6_SSH_PORT=10022  # informational only, not used by the app
TS6_USERNAME=serveradmin
TS6_PASSWORD=your_serveradmin_password
TS_API_KEY=your_api_key
TS_SERVER_ID=1
TS_MEMBER_GROUP_ID=6
TS_ADMIN_GROUP_ID=7

# === TeamSpeak 3 (ServerQuery TCP — default port 10011) ===
TS3_HOST=your_teamspeak3_server_ip
TS3_PORT=10011
TS3_USERNAME=serveradmin
TS3_PASSWORD=your_serveradmin_password
TS3_SERVER_ID=1
TS3_MEMBER_GROUP_ID=6
TS3_ADMIN_GROUP_ID=7

# Whether all of the TS3/TS6 settings above (+ TS_BOT_NICKNAME) are overridable from
# Dev Tools > Ustawienia > Logowanie ("panel") or always read from here ("env", default).
# Same boot-time-only flag as DISCORD_ROLES_CONFIG_SOURCE above — the escape hatch if a
# panel-managed value ever breaks TS login: set back to "env" and restart.
# TS_CONFIG_SOURCE=panel

# === App Settings ===
SESSION_SECRET=change_this_to_a_random_secret_string
PORT=3000
NODE_ENV=production

# === iframe Embedding ===
# Whether embedding is allowed, the allowed origins list, videos/page, grid columns,
# and logs/page are now all configured in-app under Dev Tools > Ustawienia
# (DB-backed, no restart needed).

# === Streaming Service ===
STREAM_SECRET=change_this_to_a_random_stream_secret
STREAM_URL=http://streaming:4000
# For key URLs in HLS manifests — the public URL of your streaming service
STREAM_PUBLIC_URL=https://your-domain.com/stream
ALLOWED_ORIGIN=https://your-domain.com

# === GPU (NVENC) Transcoding — optional ===
# Only used when running with the docker-compose.gpu.yml override (see that file); ignored
# otherwise. Requires the NVIDIA Container Toolkit already working for a plain custom
# container on this host (Unraid: the "Nvidia-Driver" plugin).
# NVIDIA_VISIBLE_DEVICES=all           # or a specific GPU UUID, e.g. GPU-1cb7b75e-20e3-5e0e-4cd8-4151783b3274
# NVIDIA_DRIVER_CAPABILITIES=all

# === Streaming Storage ===
# Where your videos actually live ON THE HOST — read by docker-compose.yml to bind-mount into
# the streaming container's /data. Set this to your real array/NFS/Tailscale-mounted path. Leave
# unset and it falls back to a plain (non-persistent-across-reinstalls) Docker named volume.
# IMPORTANT: set this here, in .env — never hardcode the path directly in docker-compose.yml's
# volumes: line for the streaming service; a hand-edit there is easy to lose on a future pull,
# which silently points the container at an empty volume while your real videos stay untouched
# but orphaned at the old path (this has actually happened — see git history if curious).
# STREAM_HOST_DATA_DIR=/mnt/user/alleria-streaming

# Paths INSIDE the streaming container (default: /data and subdirs) — only for reorganizing the
# internal layout; almost never needed alongside STREAM_HOST_DATA_DIR above, and does NOT by
# itself change what's persisted on the host (that's controlled by STREAM_HOST_DATA_DIR + the
# volumes: line in docker-compose.yml, not by these).
# STREAM_DATA_DIR=/data
# STREAM_MEDIA_DIR=/data/media
# STREAM_KEYS_DIR=/data/keys
# STREAM_UPLOAD_DIR=/data/uploads
