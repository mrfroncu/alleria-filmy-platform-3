# === Discord OAuth2 ===
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
# IMPORTANT: Must match EXACTLY what is in Discord Developer Portal > OAuth2 > Redirects
# Both /auth/discord/callback and /api/auth/discord/callback work
DISCORD_REDIRECT_URI=https://your-domain.com/auth/discord/callback
DISCORD_BOT_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_discord_guild_id

# === Discord Role IDs ===
# Role that grants basic access to the platform
DISCORD_MEMBER_ROLE_ID=123456789012345678
# Role that grants admin/editor access  
DISCORD_ADMIN_ROLE_ID=123456789012345679
# Role that grants developer/debug access
DISCORD_DEV_ROLE_ID=123456789012345680

# === TeamSpeak 6 (ServerQuery HTTP API) ===
# Both TS6_ and TS_ prefixes work (e.g. TS6_HOST or TS_SERVER_HOST)
TS_SERVER_HOST=your_teamspeak_server_ip
TS_API_PORT=10080
# TS6_SSH_PORT=10022  # informational only, not used by the app
TS6_USERNAME=serveradmin
TS6_PASSWORD=your_serveradmin_password
TS_API_KEY=your_api_key
TS_SERVER_ID=1
TS_MEMBER_GROUP_ID=6
TS_ADMIN_GROUP_ID=7

# === App Settings ===
SESSION_SECRET=change_this_to_a_random_secret_string
PORT=3000
NODE_ENV=production

# === Display Settings ===
# Videos per page on main page (should be multiple of GRID_COLUMNS, default: 12)
VIDEOS_PER_PAGE=12
# Max number of grid columns on desktop (mobile auto-adjusts: 1 col phone, 2 col tablet, default: 3)
GRID_COLUMNS=3
# Logs per page in admin panel (default: 50)
LOGS_PER_PAGE=50

# === Streaming Service ===
STREAM_SECRET=change_this_to_a_random_stream_secret
STREAM_URL=http://streaming:4000
# For key URLs in HLS manifests — the public URL of your streaming service
STREAM_PUBLIC_URL=https://your-domain.com/stream
ALLOWED_ORIGIN=https://your-domain.com

# === Streaming Storage (set in streaming container's environment) ===
# Root data directory (default: /data)
# STREAM_DATA_DIR=/mnt/user/alleria-streaming
# Or set each path individually:
# STREAM_MEDIA_DIR=/mnt/user/alleria-streaming/videos
# STREAM_KEYS_DIR=/mnt/user/alleria-streaming/keys
# STREAM_UPLOAD_DIR=/mnt/user/alleria-streaming/uploads
