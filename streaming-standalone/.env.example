# === Alleria Streaming Service — Standalone Deployment ===
# Deploy this on a separate server (e.g. via Tailscale) to offload video storage & transcoding
# The main Alleria Filmy app connects to this service via STREAM_URL

# Secret token — must match STREAM_SECRET in the main app's .env
STREAM_SECRET=change_this_to_match_main_app

# Port the streaming service listens on
STREAM_PORT=4000

# Allowed origin for CORS (your main app domain)
ALLOWED_ORIGIN=https://videos.alleria.pl

# Public URL — how the main app's frontend reaches this service
# Usually proxied through the main app, so this is the main app's /stream path
STREAM_PUBLIC_URL=https://videos.alleria.pl/stream

# === GPU (NVENC) Transcoding — optional ===
# Only used when running with docker-compose.gpu.yml (in this folder) merged in; ignored
# otherwise. Requires the NVIDIA Container Toolkit already working for a plain custom
# container on this host.
# STREAM_USE_GPU=true
# NVIDIA_VISIBLE_DEVICES=all           # or a specific GPU UUID, e.g. GPU-1cb7b75e-20e3-5e0e-4cd8-4151783b3274
# NVIDIA_DRIVER_CAPABILITIES=all

# === Storage Paths ===
# Where your videos actually live ON THE HOST — read by docker-compose.yml to bind-mount into
# the container's /data. Set this to your real array/NFS/Tailscale-mounted path. Leave unset and
# it falls back to a plain (non-persistent-across-reinstalls) Docker named volume.
# IMPORTANT: set this here, in .env — never hardcode the path directly in docker-compose.yml's
# volumes: line. That file is tracked in git, so a `git pull` on update overwrites a hand-edit
# there back to the default, silently pointing the container at an empty volume while your real
# videos stay untouched but orphaned at the old path.
# STREAM_HOST_DATA_DIR=/mnt/user/alleria-videos-streamer-data

# Paths INSIDE the container (default: /data and subdirs) — only relevant if you want to
# reorganize the internal layout; almost never needed alongside STREAM_HOST_DATA_DIR above.
# STREAM_DATA_DIR=/data
# STREAM_MEDIA_DIR=/data/media
# STREAM_KEYS_DIR=/data/keys
# STREAM_UPLOAD_DIR=/data/uploads

INTEGRATION_API_KEY=<long random string>